# ── AngklungineX — environment template ──
# Salin file ini jadi `.env` lalu isi nilainya. JANGAN commit `.env`.
#
#   cp .env.example .env
#
# Generate nilai acak:   openssl rand -hex 24

# Token akses WebSocket service (backend). Kalau diisi, koneksi WS wajib
# bawa ?token=<nilai ini>. Kosong = auth nonaktif (mode dev/lokal).
WS_TOKEN=

# Token Cloudflare Tunnel (cloudflared). Didapat dari:
#   docker run --rm -it cloudflare/cloudflared tunnel token angklunginex-ws
# (setelah `tunnel login` + `tunnel create`). WAJIB diisi sebelum
# `docker compose up -d` agar service cloudflared bisa jalan.
TUNNEL_TOKEN=

# Opsional: host/port WebSocket service saat menjalankan tanpa Docker.
# (Biasanya cukup default 8765.)
# SERVICE_PORT=8765
